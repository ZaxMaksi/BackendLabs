# ==============================================================================
# Environment Configuration Template (12-Factor App)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Django Core Settings
SECRET_KEY=change-this-in-production-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_NAME=task_tracker_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# In-Memory Cache Configuration (django.core.cache)
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=task_tracker_locmem_cache
CACHE_DEFAULT_TIMEOUT=300

# External REST API Configuration (Calendar / Public Holidays Service)
EXTERNAL_API_BASE_URL=https://date.nager.at/api/v3
EXTERNAL_API_TIMEOUT=3.0
EXTERNAL_API_CACHE_TTL=300

# Background Task Processing (ThreadPoolExecutor)
BACKGROUND_TASK_MAX_WORKERS=4
BACKGROUND_TASK_SIMULATE_DELAY=0.0

# Optional: LLM Configuration (Google AI Studio / Gemini API)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.1-flash-lite
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600
LLM_TIMEOUT=30
LLM_TOKEN_BUDGET=3000
